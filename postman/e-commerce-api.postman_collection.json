    {
      "name": "Addresses",
      "item": [
        {
          "name": "List Addresses",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/u/addresses/" }
        },
        {
          "name": "Create Address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Home\",\n  \"street\": \"123 Main Street\",\n  \"city\": \"Example City\",\n  \"state\": \"Example State\",\n  \"postal_code\": \"123456\",\n  \"country\": \"Example Country\",\n  \"is_default\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/u/addresses/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
