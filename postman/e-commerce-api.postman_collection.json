{
  "info": {
    "_postman_id": "f2dbf4a1-4d6c-4c3f-8b5e-2d0b1b8c2f31",
    "name": "E-Commerce API",
    "description": "Postman collection for the Django REST e-commerce API. Set baseUrl, then run Register or Login to populate access and refresh token variables. All JSON responses use the CoreRenderer envelope: status, status_code, timestamp, and data/error.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "productSlug", "value": "example-product-123" },
    { "key": "productId", "value": "1" },
    { "key": "variantId", "value": "1" },
    { "key": "bannerId", "value": "1" },
    { "key": "eventBannerId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "cartId", "value": "1" },
    { "key": "wishListItemId", "value": "1" },
    { "key": "addressId", "value": "1" },
    { "key": "instagramPostId", "value": "1" },
    { "key": "searchQuery", "value": "example" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration succeeds', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns tokens', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json().data;",
                  "  pm.expect(body).to.have.property('accessToken');",
                  "  pm.expect(body).to.have.property('refreshToken');",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtain JWT Pair",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/token/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JWT pair is returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json().data;",
                  "  pm.expect(body).to.have.property('access');",
                  "  pm.expect(body).to.have.property('refresh');",
                  "  pm.collectionVariables.set('accessToken', body.access);",
                  "  pm.collectionVariables.set('refreshToken', body.refresh);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/token/refresh/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh returns a new token pair', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json().data;",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me/"
          }
        },
        {
          "name": "Update Current User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated User\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/me/"
          }
        },
        {
          "name": "OAuth Login (Google)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"token\": \"paste-google-id-token-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/oauth/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json().data;",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/" }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example Product\",\n  \"description\": \"A product description\",\n  \"attributes\": { \"color\": \"blue\" },\n  \"is_active\": true,\n  \"related_variant_ids\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product is created', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "  if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('productSlug', pm.response.json().data.slug);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productSlug}}/" }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Product\",\n  \"description\": \"Updated description\",\n  \"attributes\": { \"color\": \"green\" },\n  \"is_active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/{{productSlug}}/"
          }
        },
        {
          "name": "Delete Product",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/products/{{productSlug}}/" }
        }
      ]
    },
    {
      "name": "Catalog Discovery",
      "item": [
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/search/?q={{searchQuery}}"
          }
        },
        {
          "name": "List Newly Launched",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/newly-launched/" }
        }
      ]
    },
    {
      "name": "Banners",
      "item": [
        {
          "name": "List Banners",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/api/banners/" }
        },
        {
          "name": "Create Banner",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Homepage Banner", "type": "text" },
                { "key": "altText", "value": "Homepage promotion", "type": "text" },
                { "key": "imageUrl", "type": "file", "src": "" },
                { "key": "url", "value": "https://example.com", "type": "text" },
                { "key": "is_active", "value": "true", "type": "text" },
                { "key": "starts_at", "value": "2026-01-01T00:00:00Z", "type": "text" },
                { "key": "ends_at", "value": "2026-12-31T23:59:59Z", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/banners/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('bannerId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Banner",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/api/banners/{{bannerId}}/" }
        },
        {
          "name": "Update Banner",
          "request": {
            "method": "PATCH",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Updated Homepage Banner", "type": "text" },
                { "key": "is_active", "value": "true", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/banners/{{bannerId}}/"
          }
        },
        {
          "name": "Delete Banner",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/banners/{{bannerId}}/" }
        }
      ]
    },
    {
      "name": "Event Banners",
      "item": [
        {
