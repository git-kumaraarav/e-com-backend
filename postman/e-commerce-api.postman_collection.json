          "name": "List Cached Instagram Posts",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/instagram-feed/"
          }
        },
        {
          "name": "Get Cached Instagram Post",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/instagram-feed/{{instagramPostId}}/"
          }
        }
      ]
    }
