    },
    {
      "name": "Orders",
      "description": "The project currently exposes read-only order history at this route.",
      "item": [
        {
          "name": "Place Order (Checkout)",
          "description": "Requires authentication, an address ID belonging to the authenticated user, and at least one item in their cart. On success, the cart is cleared; the response order ID is saved to orderId.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": {{addressId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/u/checkout/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checkout creates an order', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data).to.have.property('id');",
                  "  pm.collectionVariables.set('orderId', body.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List My Orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders-history/" }
        },
        {
          "name": "Get Order",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders-history/{{orderId}}/" }
        }
      ]
    },
    {
